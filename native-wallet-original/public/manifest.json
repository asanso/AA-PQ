{
  "manifest_version": 3,
  "name": "NiceTry Daisugi — native frames dev",
  "short_name": "NiceTry Daisugi",
  "version": "2.1.3.1",
  "description": "Daisugi testnet wallet using SPHINCS-G native frame transactions through an explicitly configured HTTPS endpoint.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.4byte.directory/*",
    "https://api.coingecko.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "nicetry_logo_.png",
      "48": "nicetry_logo_.png",
      "128": "nicetry_logo_.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "nicetry_logo_.png",
    "48": "nicetry_logo_.png",
    "128": "nicetry_logo_.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://daisugi.fyi/*"
      ],
      "js": [
        "inpage.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://daisugi.fyi/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inpage.js"
      ],
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://daisugi.fyi/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "121",
  "version_name": "2.1.3 · native frames dev"
}
