From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ManuelArto <manuelartociao@gmail.com>
Date: Thu, 12 Nov 2026 15:25:43 +0100
Subject: [PATCH 12/14] test(daisugi): pin Keccak-era Nethermind blocks and
 reject BLAKE2s-era ones

Vectors come from Nethermind 5a79d005f8: the synthetic ones from its payload conversion, the
fixtures from a local mixed leanSPHINCS + leanSTARK devnet. A flipped proof byte and the
BLAKE2s-era blocks fail the local block hash check.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../execution_layer/src/daisugi_block_hash.rs | 97 ++++++++++++-------
 .../daisugi_keccak_first_block.json           |  1 +
 .../daisugi_keccak_mixed_block.json           |  1 +
 3 files changed, 64 insertions(+), 35 deletions(-)
 create mode 100644 beacon_node/execution_layer/src/test_fixtures/daisugi_keccak_first_block.json
 create mode 100644 beacon_node/execution_layer/src/test_fixtures/daisugi_keccak_mixed_block.json

diff --git a/beacon_node/execution_layer/src/daisugi_block_hash.rs b/beacon_node/execution_layer/src/daisugi_block_hash.rs
index 1764ba787cf05ee0c1d5b023d7a7393a3bc6bd04..f660e29c91baf721aefa9b30e33018f7e4eae782 100644
--- a/beacon_node/execution_layer/src/daisugi_block_hash.rs
+++ b/beacon_node/execution_layer/src/daisugi_block_hash.rs
@@ -65,7 +65,10 @@ pub fn block_deps_hash<'a>(
 
 fn deps_hash(dependencies: &[Dependency]) -> Hash256 {
     let sphincs = list_deps_hash(dependencies, true);
-    if dependencies.iter().all(|(scheme, _, _)| *scheme == LEAN_SPHINCS_SCHEME) {
+    if dependencies
+        .iter()
+        .all(|(scheme, _, _)| *scheme == LEAN_SPHINCS_SCHEME)
+    {
         return Hash256::from(sphincs);
     }
     // Every other scheme joins the leanSTARK list, so no entry escapes the digest.
@@ -200,11 +203,11 @@ mod test {
         let txs = transactions();
         assert_eq!(
             block_deps_hash(txs.iter().map(Vec::as_slice)).unwrap(),
-            hash("0x0cb304bc6cc6e938a99845781b3a17c185f4f9978b4876b772e66c7c00314c16")
+            hash("0x164bfa8e70b0748321ce4efd20d1c7748804c05f1f64d86b86ec4bb228a573a6")
         );
         assert_eq!(
             block_deps_hash(std::iter::empty()).unwrap(),
-            hash("0x69217a3079908094e11121d042354a7c1f55b6482ca1a51e1b250dfd1ed0eef9")
+            hash("0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470")
         );
     }
 
@@ -289,7 +292,7 @@ mod test {
         assert_eq!(
             block_hash,
             ExecutionBlockHash::from_root(hash(
-                "0x105091a58495c9c37ff1173a66aadd47acdac642fc38224b617366028c224f4a"
+                "0x962d39362d627fe70e5239a2bb624af305f19b6c484556d05f9707dd7c5cea7c"
             ))
         );
     }
@@ -303,6 +306,7 @@ mod devnet_test {
     use crate::calculate_execution_block_hash;
     use crate::engine_api::{NewPayloadRequest, NewPayloadRequestDaisugi};
     use serde::Deserialize;
+    use std::str::FromStr;
     use types::{
         ExecutionPayloadDaisugi, ExecutionPayloadRef, ExecutionRequests, Hash256, MainnetEthSpec,
     };
@@ -328,47 +332,70 @@ mod devnet_test {
         assert!(reproduces_block_hash(fixture));
     }
 
+    fn request(block: &Block) -> NewPayloadRequest<'_, MainnetEthSpec> {
+        NewPayloadRequest::Daisugi(NewPayloadRequestDaisugi {
+            execution_payload: &block.payload,
+            versioned_hashes: vec![],
+            parent_beacon_block_root: block.parent_beacon_block_root,
+            execution_requests: &block.execution_requests,
+        })
+    }
+
+    /// The first Daisugi block (slot 96, no dependencies) and block 329 of a local devnet (Nethermind `5a79d005f8`,
+    /// Keccak-256 `DEPS_HASH`): four frame transactions, two with a leanSPHINCS dependency and two with a leanSPHINCS
+    /// and a leanSTARK dependency, so a split-domain dependency digest, and the producer's 295920-byte recursive proof
+    /// with recursive children.
+    const KECCAK_FIRST_BLOCK: &str = include_str!("test_fixtures/daisugi_keccak_first_block.json");
+    const KECCAK_MIXED_BLOCK: &str = include_str!("test_fixtures/daisugi_keccak_mixed_block.json");
+
     #[test]
-    fn first_devnet_block_hash_is_reproduced() {
-        assert_block_hash_is_reproduced(include_str!(
-            "test_fixtures/daisugi_devnet_first_block.json"
-        ));
+    fn keccak_devnet_blocks_are_reproduced() {
+        assert_block_hash_is_reproduced(KECCAK_FIRST_BLOCK);
+        assert_block_hash_is_reproduced(KECCAK_MIXED_BLOCK);
     }
 
-    /// A frame transaction with a leanSig dependency bound to its signature hash and a leanSTARK dependency, carrying
-    /// the producer's 326624-byte recursive proof (block 2503). Its producer elided the signature bytes from the
-    /// signature hash, which ethereum/EIPs#12502 replaced with their length, so its block hash no longer reproduces.
+    /// The dependency digest Nethermind put in block 329's header (`blockDepsHash` from `eth_getBlockByNumber`).
     #[test]
-    fn proof_bearing_block_with_elided_signature_bytes_is_not_reproduced() {
-        assert!(!reproduces_block_hash(include_str!(
-            "test_fixtures/daisugi_devnet_proof_block.json"
-        )));
+    fn mixed_dependency_hash_matches_the_nethermind_header() {
+        let block: Block = serde_json::from_str(KECCAK_MIXED_BLOCK).unwrap();
+        assert_eq!(
+            super::block_deps_hash(block.payload.transactions.iter().map(|tx| &tx[..])).unwrap(),
+            Hash256::from_str("0xb4730a9f81f92f166fd8b7222fb0bc8d12d1b074adaf0e44686b193be9a4b257")
+                .unwrap()
+        );
     }
 
-    /// Block 447 of a local devnet (Nethermind `b0e83c01bf`, Prague with EIP-8288 and no EIP-7843): two frame
-    /// transactions, each with a zero-data-hash leanSig dependency and a leanSTARK dependency, and the producer's
-    /// 326272-byte recursive proof.
     #[test]
-    fn proof_bearing_block_with_signature_lengths_is_reproduced() {
-        assert_block_hash_is_reproduced(include_str!(
-            "test_fixtures/daisugi_devnet_zero_data_hash_proof_block.json"
+    fn mixed_block_passes_the_local_block_hash_check() {
+        let block: Block = serde_json::from_str(KECCAK_MIXED_BLOCK).unwrap();
+        request(&block)
+            .perform_optimistic_sync_verifications()
+            .unwrap();
+    }
+
+    /// The header commits to `keccak(stark_proof)`: one flipped proof byte must fail the local check, whatever the EL says.
+    #[test]
+    fn tampered_proof_fails_the_local_block_hash_check() {
+        let mut block: Block = serde_json::from_str(KECCAK_MIXED_BLOCK).unwrap();
+        let mut proof = block.payload.recursive_stark_proof.bytes().to_vec();
+        proof[1000] ^= 1;
+        block.payload.recursive_stark_proof = proof.try_into().unwrap();
+        assert!(matches!(
+            request(&block).verify_payload_block_hash(),
+            Err(crate::Error::BlockHashMismatch { .. })
         ));
     }
 
-    /// Optimistic sync checks the block hash and the versioned hashes locally; the same block must pass
-    /// both without the execution layer.
+    /// Blocks of a devnet whose Nethermind hashed dependencies with BLAKE2s. They differ from a Keccak block only in the
+    /// dependency digest (the first one has no dependency at all), and none is reproduced.
     #[test]
-    fn proof_bearing_block_with_signature_lengths_passes_optimistic_sync_checks() {
-        let block: Block = serde_json::from_str(include_str!(
-            "test_fixtures/daisugi_devnet_zero_data_hash_proof_block.json"
-        ))
-        .unwrap();
-        let request = NewPayloadRequest::Daisugi(NewPayloadRequestDaisugi {
-            execution_payload: &block.payload,
-            versioned_hashes: vec![],
-            parent_beacon_block_root: block.parent_beacon_block_root,
-            execution_requests: &block.execution_requests,
-        });
-        request.perform_optimistic_sync_verifications().unwrap();
+    fn blake2s_devnet_blocks_are_not_reproduced() {
+        for fixture in [
+            include_str!("test_fixtures/daisugi_devnet_first_block.json"),
+            include_str!("test_fixtures/daisugi_devnet_proof_block.json"),
+            include_str!("test_fixtures/daisugi_devnet_zero_data_hash_proof_block.json"),
+        ] {
+            assert!(!reproduces_block_hash(fixture));
+        }
     }
 }
