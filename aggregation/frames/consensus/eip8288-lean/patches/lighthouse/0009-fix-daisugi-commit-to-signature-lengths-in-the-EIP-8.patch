             transactions_root,
-            hash("0x85378e169f975d6784134feacb957ee57f34ab3516078d4e9ecd369163da2669")
+            hash("0x8d10705c8b94a2b2b1e6441ba7ffe1d7bdd094adf12327905c21136f699f6509")
         );
         assert_eq!(
             block_hash,
             ExecutionBlockHash::from_root(hash(
-                "0x5c2e89e3a132ec21f25e1ea4d58884c8ec33205a5faf6ddf1c03cb9ca113d5b5"
+                "0x105091a58495c9c37ff1173a66aadd47acdac642fc38224b617366028c224f4a"
             ))
