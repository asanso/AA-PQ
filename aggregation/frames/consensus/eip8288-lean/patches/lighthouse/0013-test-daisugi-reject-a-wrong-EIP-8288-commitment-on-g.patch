+                            .execution_requests
+                            .get(&id)
+                            .cloned()
+                            .unwrap_or_default(),
+                    ),
+                )
+                .0
+            }
+            _ => ExecutionBlockHash::from_root(execution_payload.tree_hash_root()),
+        };
         Ok(execution_payload)
     }
