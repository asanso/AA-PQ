+/// A Daisugi block on the head whose recursive proof no longer matches the `keccak(stark_proof)` its block hash commits
+/// to, with a valid state root and proposer signature, so only the EIP-8288 commitment is wrong.
+async fn daisugi_block_with_tampered_proof(
+    rig: &InvalidPayloadRig,
+) -> (
+    Arc<SignedBeaconBlock<E>>,
+    Option<(KzgProofs<E>, BlobsList<E>)>,
+) {
+    let harness = &rig.harness;
+    let head_state = harness.chain.head_snapshot().beacon_state.clone();
+    let slot = head_state.slot() + 1;
+    let ((block, blobs), mut state) = harness.make_block_return_pre_state(head_state, slot).await;
+    let (mut block, _) = (*block).clone().deconstruct();
+    let BeaconBlockBodyRefMut::Daisugi(body) = block.body_mut() else {
+        panic!("expected a Daisugi block");
+    };
+    body.execution_payload
+        .execution_payload
+        .recursive_stark_proof = vec![1].try_into().unwrap();
+
+    per_block_processing(
+        &mut state,
+        &SignedBeaconBlock::from_block(block.clone(), Signature::empty()),
+        BlockSignatureStrategy::NoVerification,
+        VerifyBlockRoot::False,
+        &mut ConsensusContext::new(slot),
+        &harness.spec,
+    )
+    .unwrap();
+    *block.state_root_mut() = state.update_tree_hash_cache().unwrap();
+
+    harness.set_current_slot(slot);
+    let proposer = &harness.validator_keypairs[block.proposer_index() as usize];
+    let signed = block.sign(
+        &proposer.sk,
+        &state.fork(),
+        state.genesis_validators_root(),
+        &harness.spec,
+    );
+    (Arc::new(signed), blobs)
+}
+
+fn is_local_block_hash_mismatch(error: &BlockError) -> bool {
+    matches!(
+        error,
+        BlockError::ExecutionPayloadError(ExecutionPayloadError::LocalBlockHashMismatch(_))
+    )
+}
+
+/// EIP-8288: Lighthouse recomputes a Daisugi block hash from the payload, `keccak(stark_proof)` and the dependency hash
+/// included, and rejects a mismatch on gossip, lookup and range-sync import even when the EL answers VALID.
+#[tokio::test]
+async fn daisugi_block_with_wrong_commitment_is_rejected_on_every_import_path() {
+    let mut rig =
+        InvalidPayloadRig::new_with_spec(ForkName::Daisugi.make_genesis_spec(E::default_spec()));
+    // Honest blocks pass the local check: the mock EL builds Daisugi payloads with their real header hash.
+    rig.build_blocks(4, Payload::Valid).await;
+    let head = rig.cached_head().head_block_root();
+
+    let mock_execution_layer = rig.harness.mock_execution_layer.as_ref().unwrap();
+    mock_execution_layer.server.all_payloads_valid();
+    let (block, blobs) = daisugi_block_with_tampered_proof(&rig).await;
+    let chain = rig.harness.chain.clone();
+
+    let gossip_block = chain
+        .clone()
+        .verify_block_for_gossip(block.clone())
+        .await
+        .unwrap();
+    let error = chain
+        .process_block(
+            gossip_block.block_root,
+            gossip_block,
+            NotifyExecutionLayer::Yes,
+            BlockImportSource::Gossip,
+            || Ok(()),
+        )
+        .await
+        .unwrap_err();
+    assert!(is_local_block_hash_mismatch(&error), "gossip: {error:?}");
+
+    let lookup_block = LookupBlock::new(block.clone());
+    let error = chain
+        .process_block(
+            lookup_block.block_root(),
+            lookup_block,
+            NotifyExecutionLayer::Yes,
+            BlockImportSource::Lookup,
+            || Ok(()),
+        )
+        .await
+        .unwrap_err();
+    assert!(is_local_block_hash_mismatch(&error), "lookup: {error:?}");
+
+    // Range sync does not notify the EL; the optimistic path must not accept the block either.
+    assert!(chain.config.optimistic_finalized_sync);
+    let range_block = rig
+        .harness
+        .build_range_sync_block_from_blobs(block, blobs)
+        .unwrap();
+    match chain
+        .process_chain_segment(vec![range_block], NotifyExecutionLayer::No)
+        .await
+    {
+        ChainSegmentResult::Failed {
+            imported_blocks,
+            error,
+        } => {
+            assert!(imported_blocks.is_empty());
+            assert!(
+                is_local_block_hash_mismatch(&error),
+                "range sync: {error:?}"
+            );
+        }
+        ChainSegmentResult::Successful { .. } => panic!("range sync imported the tampered block"),
+    }
+
+    rig.recompute_head().await;
+    assert_eq!(rig.cached_head().head_block_root(), head);
+}
