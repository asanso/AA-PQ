+            if block.fork_name_unchecked() == ForkName::Daisugi {
+                let new_payload_request: NewPayloadRequest<T::EthSpec> =
+                    block_message.try_into()?;
+                new_payload_request
+                    .verify_payload_block_hash()
+                    .map_err(|e| {
+                        BlockError::ExecutionPayloadError(
+                            ExecutionPayloadError::LocalBlockHashMismatch(e),
+                        )
+                    })?;
+            }
