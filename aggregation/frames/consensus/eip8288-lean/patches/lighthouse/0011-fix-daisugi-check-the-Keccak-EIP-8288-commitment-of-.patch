+/// `DEPS_HASH` (Keccak-256) over the 64-byte `data_hash || key` entries of the leanSPHINCS list, or of every other scheme.
+fn list_deps_hash(dependencies: &[Dependency], sphincs: bool) -> [u8; 32] {
+    let entries: Vec<u8> = dependencies
+        .iter()
+        .filter(|(scheme, _, _)| (*scheme == LEAN_SPHINCS_SCHEME) == sphincs)
+        .flat_map(|(_, data_hash, key)| data_hash.iter().chain(key.iter()).copied())
+        .collect();
+    keccak256(&entries).0
 }
 
