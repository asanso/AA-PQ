     // Hash the RLP encoding of the block header.
-    let rlp_block_header = rlp_encode_block_header(&exec_block_header);
+    let rlp_block_header = if let ExecutionPayloadRef::Daisugi(daisugi) = payload {
+        let mut fields = Vec::new();
+        // Encode the known header fields directly; no decoding or untrusted length is involved.
+        let base = rlp_encode_block_header(&exec_block_header);
+        let mut body = base.as_slice();
+        let prefix = alloy_rlp::Header::decode(&mut body)
+            .expect("the locally encoded execution header is valid RLP");
+        debug_assert!(prefix.list && prefix.payload_length == body.len());
+        fields.extend_from_slice(body);
+        // The pinned EL encoding reserves absent BAL and slot fields before the proof tuple.
+        fields.extend_from_slice(&[0x80, 0x80]);
+        let proof = daisugi.recursive_stark_proof.bytes();
+        let commitment = daisugi.recursive_stark_block_deps_hash.as_slice();
+        alloy_rlp::Header {
+            list: true,
+            payload_length: proof.length() + commitment.length(),
+        }
+        .encode(&mut fields);
+        proof.encode(&mut fields);
+        commitment.encode(&mut fields);
+        let mut encoded = Vec::new();
+        alloy_rlp::Header {
+            list: true,
+            payload_length: fields.len(),
+        }
+        .encode(&mut encoded);
+        encoded.extend_from_slice(&fields);
+        encoded
+    } else {
+        rlp_encode_block_header(&exec_block_header)
+    };
     (
         ExecutionBlockHash::from_root(keccak256(&rlp_block_header)),
         rlp_transactions_root,
