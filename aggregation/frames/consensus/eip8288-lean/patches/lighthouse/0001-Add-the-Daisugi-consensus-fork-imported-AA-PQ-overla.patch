+/// Extract blob hashes from both historical scalar and keyed-nonce frame envelopes.
+/// This validates the outer envelope only, not frame execution or signatures.
+fn frame_versioned_hashes(mut encoded: &[u8]) -> Result<Vec<VersionedHash>, alloy_rlp::Error> {
+    use alloy_rlp::{Error as RlpError, Header};
+    let mut fields = Header::decode_bytes(&mut encoded, true)?;
+    if !encoded.is_empty() {
+        return Err(RlpError::Custom("Trailing frame transaction bytes"));
+    }
+    let _chain_id = u64::decode(&mut fields)?;
+    if fields.first().is_some_and(|b| *b >= 0xc0) {
+        // Keyed nonce list. Individual key semantics are enforced by the EL.
+        let _keys = Header::decode_bytes(&mut fields, true)?;
+    }
+    let _nonce = u64::decode(&mut fields)?;
+    let sender = Header::decode_bytes(&mut fields, false)?;
+    if sender.len() != 20 {
+        return Err(RlpError::Custom("Invalid frame sender"));
+    }
+    let _frames = Header::decode_bytes(&mut fields, true)?;
+    let _signatures = Header::decode_bytes(&mut fields, true)?;
+    let mut fees = Header::decode_bytes(&mut fields, true)?;
+    for _ in 0..3 {
+        let fee = Header::decode_bytes(&mut fees, false)?;
+        if fee.len() > 32 || fee.first() == Some(&0) {
+            return Err(RlpError::Custom("Invalid frame fee"));
+        }
+    }
+    if !fees.is_empty() {
+        return Err(RlpError::Custom("Unexpected frame fee field"));
+    }
+    let mut blobs = Header::decode_bytes(&mut fields, true)?;
+    let mut hashes = Vec::new();
+    while !blobs.is_empty() {
+        let bytes = Header::decode_bytes(&mut blobs, false)?;
+        if bytes.len() != 32 {
+            return Err(RlpError::Custom("Invalid frame blob hash length"));
+        }
+        hashes.push(Hash256::from_slice(bytes));
+    }
+    if !fields.is_empty() {
+        let _references = Header::decode_bytes(&mut fields, true)?;
+    }
+    if !fields.is_empty() {
+        return Err(RlpError::Custom("Unexpected frame transaction field"));
+    }
+    Ok(hashes)
+}
