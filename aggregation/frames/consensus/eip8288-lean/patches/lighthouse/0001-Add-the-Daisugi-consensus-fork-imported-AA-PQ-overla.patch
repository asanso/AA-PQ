+impl Ord for ForkName {
+    fn cmp(&self, other: &Self) -> std::cmp::Ordering {
+        fn rank(fork: ForkName) -> u8 {
+            match fork {
+                ForkName::Base => 0,
+                ForkName::Altair => 1,
+                ForkName::Bellatrix => 2,
+                ForkName::Capella => 3,
+                ForkName::Deneb => 4,
+                ForkName::Electra => 5,
+                ForkName::Daisugi => 6,
+                ForkName::Fulu => 7,
+                ForkName::Gloas => 8,
+            }
+        }
+        rank(*self).cmp(&rank(*other))
+    }
+}
+impl PartialOrd for ForkName {
+    fn partial_cmp(&self, other: &Self) -> Option<std::cmp::Ordering> {
+        Some(self.cmp(other))
+    }
+}
